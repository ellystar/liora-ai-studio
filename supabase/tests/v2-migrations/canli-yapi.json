"constraints": [
{
"d": "CHECK ((credits >= 0))",
"n": "profiles_credits_check",
"t": "profiles"
},
{
"d": "PRIMARY KEY (id)",
"n": "profiles_pkey",
"t": "profiles"
},
{
"d": "CHECK ((preferred_language = ANY (ARRAY['tr'::text, 'en'::text])))",
"n": "profiles_preferred_language_check",
"t": "profiles"
},
{
"d": "CHECK ((role = ANY (ARRAY['user'::text, 'admin'::text])))",
"n": "profiles_role_check",
"t": "profiles"
},
{
"d": "CHECK ((gender = ANY (ARRAY['female'::text, 'male'::text, 'unisex'::text])))",
"n": "models_gender_check",
"t": "models"
},
{
"d": "CHECK (((gender IS NULL) OR (gender = ANY (ARRAY['female'::text, 'male'::text]))))",
"n": "models_gender_chk",
"t": "models"
},
{
"d": "PRIMARY KEY (id)",
"n": "models_pkey",
"t": "models"
},
{
"d": "CHECK ((scope = ANY (ARRAY['general'::text, 'own'::text])))",
"n": "models_scope_check",
"t": "models"
},
{
"d": "CHECK ((source = ANY (ARRAY['admin'::text, 'user'::text])))",
"n": "models_source_chk",
"t": "models"
},
{
"d": "CHECK ((category = ANY (ARRAY['general'::text, 'shoe'::text])))",
"n": "poses_category_chk",
"t": "poses"
},
{
"d": "CHECK ((direction = ANY (ARRAY['front'::text, 'back'::text])))",
"n": "poses_direction_check",
"t": "poses"
},
{
"d": "PRIMARY KEY (id)",
"n": "poses_pkey",
"t": "poses"
},
{
"d": "CHECK (((shot_type IS NULL) OR (shot_type = ANY (ARRAY['full_body'::text, 'medium_shot'::text, 'close_up'::text]))))",
"n": "poses_shot_type_chk",
"t": "poses"
},
{
"d": "PRIMARY KEY (id)",
"n": "backgrounds_pkey",
"t": "backgrounds"
},
{
"d": "PRIMARY KEY (id)",
"n": "generations_pkey",
"t": "generations"
},
{
"d": "CHECK ((status = ANY (ARRAY['pending'::text, 'success'::text, 'failed'::text])))",
"n": "generations_status_check",
"t": "generations"
},
{
"d": "CHECK ((tool = ANY (ARRAY['ecom_studio'::text, 'pose_generator'::text, 'flat_to_ghost'::text, 'edit_photo'::text, 'style_transfer'::text, 'ai_video'::text])))",
"n": "generations_tool_check",
"t": "generations"
},
{
"d": "PRIMARY KEY (id)",
"n": "video_jobs_pkey",
"t": "video_jobs"
},
{
"d": "PRIMARY KEY (id)",
"n": "generation_images_pkey",
"t": "generation_images"
},
{
"d": "PRIMARY KEY (id)",
"n": "systems_pkey",
"t": "systems"
},
{
"d": "CHECK ((price > 0))",
"n": "systems_price_check",
"t": "systems"
},
{
"d": "CHECK ((unit = ANY (ARRAY['frame'::text, 'job'::text])))",
"n": "systems_unit_check",
"t": "systems"
}
